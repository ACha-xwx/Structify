{
    email {$ACME_EMAIL}
    admin off
}

# Historical direct-host variant. For a shared host, use
# Caddyfile.host.production as an imported site block instead. Both
# applications use Structify's dedicated loopback ports.
www.structify.cn {
    redir https://structify.cn{uri} permanent
}

(structify_routes) {
    encode zstd gzip

    route {
        @spring_sse path /api/v1/chat/stream
        handle @spring_sse {
            reverse_proxy 127.0.0.1:18792 {
                flush_interval -1
            }
        }

        @spring_api path /api/v1/*
        handle @spring_api {
            reverse_proxy 127.0.0.1:18792
        }

        @presentation path /presentation/*
        handle @presentation {
            reverse_proxy 127.0.0.1:18791
        }

        @legacy_api path /api/*
        handle @legacy_api {
            reverse_proxy 127.0.0.1:18791 {
                flush_interval -1
            }
        }

        handle {
            reverse_proxy 127.0.0.1:18791
        }
    }
}

structify.cn {
    import structify_routes
}

# This transition topology keeps the management domain on the same Node/Spring
# proxy pair. Spring performs the actual administrator authorization. Keep the
# historical direct-host sample aligned with the production host boundary.
admin.structify.cn {
    @admin_root path /
    redir @admin_root /admin 308
    @admin_non_management_spa {
        not path / /admin /admin/* /api /api/* /presentation /presentation/* /healthz /login /reset-password /403
    }
    redir @admin_non_management_spa https://structify.cn{uri} 308
    import structify_routes
}
