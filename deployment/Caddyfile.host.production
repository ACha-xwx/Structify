# Import this file from the existing host Caddyfile after its global options.
# It intentionally has no global block, listener declarations, credentials, or
# unrelated sites, so it can coexist with services already owned by host Caddy.

www.structify.cn {
    redir https://structify.cn{uri} permanent
}

(structify_routes) {
    encode zstd gzip

    log {
        output stdout
        format json
    }

    # HSTS is deliberately omitted until the domain owner confirms every
    # current and future subdomain is HTTPS-only.
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
        -Server
    }

    # Vite emits content-hashed JavaScript, CSS, fonts, and images under
    # /assets. Keep these immutable for a year; each release gets new URLs.
    @frontend_assets path /assets/*
    header @frontend_assets Cache-Control "public, max-age=31536000, immutable"

    # The HTML shell points at the hashed asset manifest, so revalidate it on
    # every navigation to pick up a release without serving stale code.
    @frontend_html path / /index.html /*.html
    header @frontend_html Cache-Control "no-cache, max-age=0, must-revalidate"

    @cors_actual_public {
        header Origin https://structify.cn
        path /api/* /presentation/*
    }
    header @cors_actual_public {
        defer
        Access-Control-Allow-Origin "https://structify.cn"
        Access-Control-Allow-Credentials "true"
        Access-Control-Expose-Headers "X-Request-Id"
        +Vary "Origin"
    }
    @cors_actual_admin {
        header Origin https://admin.structify.cn
        path /api/* /presentation/*
    }
    header @cors_actual_admin {
        defer
        Access-Control-Allow-Origin "https://admin.structify.cn"
        Access-Control-Allow-Credentials "true"
        Access-Control-Expose-Headers "X-Request-Id"
        +Vary "Origin"
    }

    route {
        @cors_preflight_public {
            method OPTIONS
            header Origin https://structify.cn
            header Access-Control-Request-Method *
            path /api/* /presentation/*
        }
        handle @cors_preflight_public {
            header {
                Access-Control-Allow-Origin "https://structify.cn"
                Access-Control-Allow-Credentials "true"
                Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
                Access-Control-Allow-Headers "Authorization, Content-Type, X-Request-Id"
                Access-Control-Max-Age "3600"
                Vary "Origin, Access-Control-Request-Method, Access-Control-Request-Headers"
            }
            respond "" 204
        }
        @cors_preflight_admin {
            method OPTIONS
            header Origin https://admin.structify.cn
            header Access-Control-Request-Method *
            path /api/* /presentation/*
        }
        handle @cors_preflight_admin {
            header {
                Access-Control-Allow-Origin "https://admin.structify.cn"
                Access-Control-Allow-Credentials "true"
                Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
                Access-Control-Allow-Headers "Authorization, Content-Type, X-Request-Id"
                Access-Control-Max-Age "3600"
                Vary "Origin, Access-Control-Request-Method, Access-Control-Request-Headers"
            }
            respond "" 204
        }

        @spring_sse path /api/v1/chat/stream
        handle @spring_sse {
            reverse_proxy 127.0.0.1:18792 {
                flush_interval -1
            }
        }

        @spring_api path /api/v1/*
        handle @spring_api {
            reverse_proxy 127.0.0.1:18792
        }

        @presentation path /presentation/*
        handle @presentation {
            reverse_proxy 127.0.0.1:18791
        }

        @legacy_api path /api/*
        handle @legacy_api {
            reverse_proxy 127.0.0.1:18791 {
                flush_interval -1
            }
        }

        handle {
            reverse_proxy 127.0.0.1:18791
        }
    }
}

structify.cn {
    import structify_routes
}

# The management frontend shares this release bundle. Administrator roles are
# enforced by Spring on every /api/v1/admin/* request. Keep copied learning
# bookmarks on the public host before the shared SPA can render them here.
admin.structify.cn {
    @admin_root path /
    redir @admin_root /admin 308
    @admin_non_management_spa {
        # Keep hashed frontend assets on the management origin. Redirecting
        # them to the public host prevents the module bundle from executing.
        not path / /admin /admin/* /assets /assets/* /api /api/* /presentation /presentation/* /healthz /login /reset-password /403
    }
    redir @admin_non_management_spa https://structify.cn{uri} 308
    import structify_routes
}
