FROM node:22-bookworm-slim AS dependencies

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts=false \
    && npm cache clean --force

FROM node:22-bookworm-slim

ENV NODE_ENV=production
WORKDIR /app

COPY --from=dependencies --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node package.json package-lock.json ./
COPY --chown=node:node server.js presentation-runtime.js index.html prototype.html ./
COPY --chown=node:node lib ./lib
COPY --chown=node:node pdfs ./default-pdfs
COPY --chown=node:node deployment/node-entrypoint.sh /usr/local/bin/node-entrypoint
RUN mkdir -p /app/pdfs /app/data \
    && chmod 755 /usr/local/bin/node-entrypoint \
    && chown -R node:node /app/pdfs /app/data

USER node
EXPOSE 8791

ENTRYPOINT ["/usr/local/bin/node-entrypoint"]
CMD ["node", "server.js"]
