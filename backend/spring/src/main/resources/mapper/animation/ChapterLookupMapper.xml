<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feng.dsagent.animation.mapper.ChapterLookupMapper">
  <select id="findPublishedTitle" resultType="string">
    SELECT title FROM chapters WHERE id = #{id} AND status = 'PUBLISHED'
  </select>
</mapper>
