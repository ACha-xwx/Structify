{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "explanation", "evidenceKeys", "scenes"],
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "explanation": {"type": "string", "minLength": 1, "maxLength": 4000},
    "evidenceKeys": {"type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^e[1-6]$"}},
    "scenes": {"type": "array", "maxItems": 8, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["resourceKey", "explanation"],
      "properties": {
        "resourceKey": {"type": "string", "pattern": "^r[1-9][0-9]?$"},
        "explanation": {"type": "string", "minLength": 1, "maxLength": 4000},
        "startLine": {"type": "integer", "minimum": 1},
        "endLine": {"type": "integer", "minimum": 1}
      }
    }}
  }
}
